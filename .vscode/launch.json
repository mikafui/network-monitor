{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Display: Electron Main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "program": "${workspaceFolder}/packages/display",
      "cwd": "${workspaceFolder}/packages/display",
      "preLaunchTask": "npm: build:display",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/display/dist/**/*.js"
      ],
      "console": "integratedTerminal"
    }
  ]
}
