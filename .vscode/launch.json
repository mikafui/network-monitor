{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Display: Electron Main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "program": "${workspaceFolder}/packages/display/dist/electron/main.js",
      "cwd": "${workspaceFolder}/packages/display",
      "preLaunchTask": "npm: build",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/display/dist/electron/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/display/electron/**",
        "!**/node_modules/**"
      ],
      "console": "integratedTerminal"
    }
  ]
}
