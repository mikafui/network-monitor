{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd",
      "program": "${workspaceFolder}/packages/electron/dist/main.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "npm: build",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/electron/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/electron/src/**",
        "!**/node_modules/**"
      ],
      "console": "integratedTerminal"
    }
  ]
}
