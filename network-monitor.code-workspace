{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "[markdown]": {
      "editor.formatOnSave": true
    },
    "eslint.validate": ["typescript", "typescriptreact", "javascript", "javascriptreact", "html"],
    "stylelint.validate": ["css", "less", "postcss", "scss"],
    "search.exclude": {
      ".history": true,
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/www": true
    },
    "files.exclude": {
      ".husky": false,
      ".history": true,
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/node_modules": false,
      "**/.releaserc": false,
      "**/dist": false,
      "**/www": false
    },
    "files.associations": {
      ".releaserc": "json",
      ".renovaterc": "json",
      ".csharpierrc": "json",
      "*.css": "css",
      "*.pcss": "css"
    },
    "dotnet.defaultSolution": "packages/collector/NetworkMonitorCollector.slnx",
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#206895",
      "activityBar.background": "#206895",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#e37cbb",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#206895",
      "statusBar.background": "#174b6b",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#206895",
      "statusBarItem.remoteBackground": "#d22d93",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#174b6b",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#174b6b99",
      "titleBar.inactiveForeground": "#e7e7e799",
      "activityBarTop.activeBackground": "#206895",
      "activityBarTop.background": "#206895",
      "activityBarTop.foreground": "#e7e7e7",
      "activityBarTop.inactiveForeground": "#e7e7e799",
      "commandCenter.foreground": "#e7e7e7",
      "statusBar.debuggingBackground": "#174b6b",
      "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "#174b6b"
  }
}
