{
  "name": "display",
  "version": "1.0.0",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "cd frontend && ng",
    "start": "npm run build && electron .",
    "build": "npm run build:frontend && npm run build:electron",
    "build:frontend": "cd frontend && ng build --project display --configuration production",
    "build:electron": "tsc --project electron/tsconfig.json",
    "watch:frontend": "cd frontend && ng build --project display --configuration development --watch",
    "test": "cd frontend && ng test --project display"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.2.0",
    "electron": "43.3.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
