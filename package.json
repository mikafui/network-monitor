{
  "name": "network-monitor",
  "version": "0.0.0",
  "main": "packages/display/dist/electron/main.js",
  "scripts": {
    "lint": "npm run lint:es && npm run lint:style",
    "lint:es": "eslint --fix --flag unstable_native_nodejs_ts_config .",
    "lint:style": "stylelint \"**/*.{scss,pcss,css}\"",
    "lint:style:fix": "stylelint --fix \"**/*.{scss,pcss,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:project:components": "vitest --project components",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "build:collector": "npm run build --workspace=collector",
    "build:display": "npm run build --workspace=display",
    "build": "npm run build:collector && npm run build:display",
    "publish:collector": "npm run publish --workspace=collector",
    "package": "npm run publish:collector && npm run build:display && electron-builder --win"
  },
  "build": {
    "appId": "de.mikafui.networkmonitor",
    "productName": "Network Monitor",
    "directories": { "output": "dist" },
    "files": ["packages/display/dist/**/*", "packages/display/package.json"],
    "extraResources": [
      { "from": "packages/collector/dist", "to": "collector" },
      { "from": "assets/icon.png", "to": "icon.png" }
    ],
    "win": {
      "target": "portable",
      "artifactName": "${productName}.${ext}",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.38.0",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "13.1.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "24.9.2",
    "@vitest/eslint-plugin": "^1.6.9",
    "autoprefixer": "10.4.21",
    "commitlint": "20.1.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-secrets": "2.2.1",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-security": "4.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "pathe": "^2.0.3",
    "prettier": "3.6.2",
    "semantic-release": "25.0.1",
    "semantic-release-ado": "1.4.0",
    "semantic-release-monorepo": "8.0.2",
    "stylelint": "17.5.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "electron-builder": "26.15.3"
  },
  "workspaces": [
    "./packages/*"
  ]
}
